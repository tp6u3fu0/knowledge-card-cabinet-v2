# The default Docker Compose setup loads Qwen3-Embedding inside the API container.
EMBEDDING_PROVIDER=local-transformers
EMBEDDING_API_URL=
EMBEDDING_API_FORMAT=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSIONS=1024
RELATED_MIN_SCORE=0.55
RELATED_LIMIT=6
RELATED_KEYWORD_WEIGHT=0.35
SEARCH_KEYWORD_WEIGHT=0.25

# API security. Use a long random value outside local development.
KCC_API_TOKEN=replace-with-a-long-random-token
KCC_API_READ_TOKEN=
KCC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional local AI card drafting. The model is downloaded on first use.
SUMMARY_PROVIDER=local-transformers
SUMMARY_MODEL=Qwen/Qwen2.5-0.5B-Instruct
SUMMARY_MAX_NEW_TOKENS=192

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional public download URL for the latest desktop installer.
NEXT_PUBLIC_DOWNLOAD_URL=
